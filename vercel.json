:root {
  --blue: #0072fb;
  --blue-dark: #005ad0;
  --blue-deep: #0050b8;
  --blue-tint: #eef5ff;
  --white: #ffffff;
  --text: #ffffff;
  --muted: rgba(255, 255, 255, 0.82);
  --border: rgba(255, 255, 255, 0.22);
  --panel: rgba(255, 255, 255, 0.1);
  --radius: 14px;
}

* { box-sizing: border-box; }

html { scroll-behavior: smooth; }

body {
  margin: 0;
  background: var(--blue);
  color: var(--text);
  font-family: system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  line-height: 1.6;
}

img { max-width: 100%; display: block; }

a { color: var(--white); text-decoration: none; }

.container {
  width: 100%;
  max-width: 1100px;
  margin: 0 auto;
  padding: 0 20px;
}

/* Nav */
.nav {
  position: sticky;
  top: 0;
  z-index: 10;
  background: rgba(0, 90, 208, 0.92);
  backdrop-filter: blur(8px);
  border-bottom: 1px solid var(--border);
}
.nav-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  height: 68px;
}
.brand { display: flex; align-items: center; gap: 10px; color: var(--text); font-weight: 700; }
.brand-mark {
  display: grid;
  place-items: center;
  width: 44px;
  height: 44px;
  border-radius: 10px;
  background: var(--blue-dark);
}
.brand-mark img { width: 38px; height: 38px; }
.nav-links { display: flex; align-items: center; gap: 22px; }
.nav-links a:not(.btn) { color: var(--muted); font-weight: 500; }
.nav-links a:not(.btn):hover { color: var(--white); }

/* Buttons */
.btn {
  display: inline-block;
  padding: 12px 22px;
  border-radius: 999px;
  background: var(--white);
  color: var(--blue);
  font-weight: 600;
  border: 2px solid var(--white);
  transition: background 0.15s, color 0.15s;
}
.btn:hover { background: var(--blue-tint); border-color: var(--blue-tint); }
.btn-small { padding: 8px 16px; font-size: 0.95rem; white-space: nowrap; }
.btn-outline { background: transparent; color: var(--white); }
.btn-outline:hover { background: var(--panel); color: var(--white); border-color: var(--white); }
.btn-light { background: var(--white); color: var(--blue); border-color: var(--white); }
.btn-light:hover { background: var(--blue-tint); border-color: var(--blue-tint); }

/* Hero */
.hero { padding: 80px 0 72px; }
.hero-inner {
  display: grid;
  grid-template-columns: 1.2fr 1fr;
  align-items: center;
  gap: 48px;
}
.eyebrow {
  margin: 0 0 8px;
  color: var(--muted);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  font-size: 0.85rem;
}
h1 {
  margin: 0 0 16px;
  font-size: clamp(2.4rem, 5vw, 3.6rem);
  line-height: 1.1;
}
h1 span { color: var(--white); text-decoration: underline; text-decoration-thickness: 6px; text-underline-offset: 8px; }
.lead { margin: 0 0 28px; font-size: 1.15rem; color: var(--muted); max-width: 34em; }
.hero-actions { display: flex; flex-wrap: wrap; gap: 12px; }
.hero-logo {
  justify-self: center;
  width: min(100%, 340px);
  aspect-ratio: 1;
  border-radius: 32px;
  background: var(--blue-dark);
  box-shadow: 0 24px 60px rgba(0, 40, 110, 0.35);
  display: grid;
  place-items: center;
}
.hero-logo img { width: 90%; height: auto; }

/* Sections */
.section { padding: 72px 0; }
.section-tint { background: var(--blue-dark); }
h2 { margin: 0 0 28px; font-size: 2rem; }

.cards {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
}
.card {
  padding: 24px;
  background: var(--panel);
  border: 1px solid var(--border);
  border-top: 4px solid var(--white);
  border-radius: var(--radius);
}
.card h3 { margin: 0 0 8px; }
.card p { margin: 0; color: var(--muted); }

.dept-list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14px;
}
.dept-list li {
  padding: 16px 20px;
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  font-weight: 600;
}

/* CTA */
.cta { background: var(--blue-deep); color: var(--white); padding: 64px 0; text-align: center; }
.cta h2 { margin-bottom: 8px; }
.cta p { margin: 0 0 24px; opacity: 0.9; }

/* Footer */
.footer { padding: 28px 0; background: var(--blue-deep); border-top: 1px solid var(--border); color: var(--muted); font-size: 0.9rem; text-align: center; }
.footer p { margin: 0; }

/* Responsive */
@media (max-width: 820px) {
  .hero { padding: 48px 0; }
  .hero-inner { grid-template-columns: 1fr; text-align: center; }
  .hero-logo { order: -1; width: 200px; }
  .lead { margin-left: auto; margin-right: auto; }
  .hero-actions { justify-content: center; }
  .cards, .dept-list { grid-template-columns: 1fr; }
  .nav-links a:not(.btn) { display: none; }
  .brand-name { font-size: 0.95rem; }
}

/* Departments page */
.nav-links a[aria-current="page"] { color: var(--white); }
.page-hero { padding: 64px 0 48px; }
.page-hero .lead { margin-bottom: 20px; }
.rules { margin: 0; padding-left: 20px; color: var(--muted); }
.rules li + li { margin-top: 4px; }

.status-head { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 16px; margin-bottom: 24px; }
.status-head h2 { margin: 0; }
.status-pill {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 6px 14px;
  border-radius: 999px;
  background: var(--panel);
  border: 1px solid var(--border);
  font-weight: 600;
  font-size: 0.95rem;
}
.status-pill::before { content: ""; width: 10px; height: 10px; border-radius: 50%; background: #c7d2e0; }
.status-pill[data-state="online"]::before { background: #3ddc84; box-shadow: 0 0 0 4px rgba(61, 220, 132, 0.25); }
.status-pill[data-state="idle"]::before { background: #ffc94d; }
.status-pill[data-state="offline"]::before { background: #ff6b6b; }

.stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
.stat {
  display: flex;
  flex-direction: column;
  padding: 20px;
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: var(--radius);
}
.stat-value { font-size: 1.8rem; font-weight: 700; line-height: 1.2; overflow-wrap: anywhere; }
.stat-label { color: var(--muted); font-size: 0.9rem; }
.status-note { margin: 16px 0 0; color: var(--muted); font-size: 0.9rem; }

.dept-grid { display: grid; gap: 24px; }
.dept {
  padding: 28px;
  background: var(--panel);
  border: 1px solid var(--border);
  border-left: 4px solid var(--white);
  border-radius: var(--radius);
}
.dept h2 { margin: 0 0 12px; font-size: 1.6rem; }
.dept p { margin: 0 0 20px; color: var(--muted); }
.dept .dept-tag {
  margin: 0 0 4px;
  color: var(--white);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  font-size: 0.8rem;
  opacity: 0.85;
}
.dept-foot { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; }
.dept-count { color: var(--muted); font-size: 0.95rem; }
.dept-count:empty { display: none; }

@media (max-width: 820px) {
  .stats { grid-template-columns: repeat(2, 1fr); }
  .dept { padding: 22px; }
  .dept-foot .btn { width: 100%; text-align: center; }
}
.dept-list a { display: block; }
.section-more { margin: 24px 0 0; }
